"""
digital_twin/visualization/diagram.py
=====================================
Geothermal process flow diagram drawn on a tkinter Canvas.
Refactored for the Phase 5.1 Engineering Layout.
"""

from __future__ import annotations

import math
import tkinter as tk
from typing import Callable, Any

from gui.theme import (
    BG_PRIMARY, BG_SECONDARY, BG_TERTIARY, BG_HEADER, BORDER, BORDER_LIGHT,
    TEXT_PRIMARY, TEXT_SECONDARY, TEXT_MUTED,
    CLR_NORMAL, CLR_WARNING, CLR_CRITICAL, CLR_OFFLINE,
    CLR_HOT_FLUID, CLR_WARM_FLUID, CLR_COOL_FLUID, CLR_PIPE_BG,
    FONT_MONO_MD, FONT_MONO_SM, FONT_LABEL, FONT_LABEL_SM, FONT_SUBTITLE,
    PIPE_WIDTH
)
from digital_twin.visualization.popups import HoverTooltip

# ─── Layout constants ────────────────────────────────────────────────────────

_Y_WELL     = 40
_Y_P101     = 130
_Y_SEP      = 220
_Y_HX       = 310
_Y_P201     = 400
_Y_DH       = 490
_Y_P301     = 580
_Y_RW       = 670

_EQUIP_W = 200
_EQUIP_H = 40

class ProcessDiagram(tk.Frame):
    def __init__(self, parent: tk.Widget, width: int = 800, height: int = 750,
                 on_equip_click: Callable[[str, str], None] | None = None, **kwargs):
        super().__init__(parent, bg=BG_PRIMARY, **kwargs)
        
        lbl = tk.Label(self, text="DIGITAL TWIN ENGINEERING PLATFORM", bg=BG_PRIMARY, fg=TEXT_SECONDARY, font=FONT_SUBTITLE)
        lbl.pack(fill="x", pady=(4, 4))

        self.canvas = tk.Canvas(self, width=width, height=height,
                                bg=BG_PRIMARY, highlightthickness=1, highlightbackground=BORDER)
        self.canvas.pack(fill="both", expand=True)
        
        self._width  = width
        self._height = height
        self._flow_offset = 0
        self._pump_angle = 0
        self._pump_running = False
        self._on_click_cb = on_equip_click

        self._equip_boxes: dict[str, int] = {}
        self._pump_rotors: dict[str, list[int]] = {}
        self._labels: dict[str, dict[str, int]] = {}
        self._tooltips: list[HoverTooltip] = []

        self._draw_static()
        self._animate_tick()

    def _register_interactive(self, tag: str, equip_id: str, equip_type: str):
        """Binds click and hover events to a canvas tag."""
        # Click event
        if self._on_click_cb:
            self.canvas.tag_bind(tag, "<Button-1>", lambda e, eid=equip_id, etyp=equip_type: self._on_click_cb(eid, etyp))
            self.canvas.tag_bind(tag, "<Enter>", lambda e: self.canvas.config(cursor="hand2"), add="+")
            self.canvas.tag_bind(tag, "<Leave>", lambda e: self.canvas.config(cursor=""), add="+")

        # Fallback hover tooltip
        def make_tooltip_text(eid=equip_id, etyp=equip_type):
            if not hasattr(self, '_facility') or not self._facility:
                return f"{etyp} | {eid}\nNo data available"
            eq = self._facility.get_equipment(eid)
            if not eq:
                return f"{etyp} | {eid}\nNo data available"
            return f"Click for detailed engineering panel"
            
        self._tooltips.append(HoverTooltip(self.canvas, tag, make_tooltip_text))

    def _draw_box(self, cx, cy, wid, name, tag):
        box = self.canvas.create_rectangle(
            cx - _EQUIP_W // 2, cy - _EQUIP_H // 2,
            cx + _EQUIP_W // 2, cy + _EQUIP_H // 2,
            fill=BG_TERTIARY, outline=CLR_NORMAL, width=2, tags=("equip", tag)
        )
        self._equip_boxes[wid] = box
        self._register_interactive(tag, wid, name)
        self.canvas.create_text(cx, cy - 10, text=name.upper(), fill=TEXT_PRIMARY, font=FONT_LABEL, anchor="center", tags=(tag,))
        lbl = self.canvas.create_text(cx, cy + 10, text="---", fill=TEXT_SECONDARY, font=FONT_MONO_MD, anchor="center", tags=(tag,))
        self._labels[wid] = {"info": lbl}
        return box

    def _draw_pump(self, cx, cy, pid, name, tag):
        r = 24
        box = self.canvas.create_oval(
            cx - r, cy - r, cx + r, cy + r,
            fill=BG_TERTIARY, outline=CLR_NORMAL, width=2, tags=("equip", tag)
        )
        self._equip_boxes[pid] = box
        self._register_interactive(tag, pid, name)
        
        # Draw dynamic rotor lines (will animate)
        l1 = self.canvas.create_line(cx-14, cy, cx+14, cy, fill=TEXT_PRIMARY, width=2, tags=(tag,))
        l2 = self.canvas.create_line(cx, cy-14, cx, cy+14, fill=TEXT_PRIMARY, width=2, tags=(tag,))
        self._pump_rotors[pid] = [l1, l2]
        
        # Draw text centered under the pump
        self.canvas.create_text(cx, cy + r + 10, text=name.upper(), fill=TEXT_PRIMARY, font=FONT_LABEL_SM, anchor="center", tags=(tag,))
        lbl = self.canvas.create_text(cx, cy + r + 24, text="---", fill=TEXT_SECONDARY, font=FONT_MONO_SM, anchor="center", tags=(tag,))
        self._labels[pid] = {"info": lbl}
        return box

    def _draw_static(self):
        cx = self._width // 2

        self._draw_box(cx, _Y_WELL, "GW-01", "Production Well", "interactive_GW-01")
        self._draw_pipe_vertical(cx, _Y_WELL + _EQUIP_H//2, _Y_P101 - 24, "hot")
        
        self._draw_pump(cx, _Y_P101, "P-101", "Production Pump", "interactive_P-101")
        self._draw_pipe_vertical(cx, _Y_P101 + 55, _Y_SEP - _EQUIP_H//2, "hot")
        
        self._draw_box(cx, _Y_SEP, "SEP-01", "Brine Separator", "interactive_SEP-01")
        self._draw_pipe_vertical(cx, _Y_SEP + _EQUIP_H//2, _Y_HX - _EQUIP_H//2, "hot")
        
        self._draw_box(cx, _Y_HX, "HX-101", "Primary Heat Exchanger", "interactive_HX-101")
        self._draw_pipe_vertical(cx, _Y_HX + _EQUIP_H//2, _Y_P201 - 24, "warm")
        
        self._draw_pump(cx, _Y_P201, "P-201", "DH Circulation Pump", "interactive_P-201")
        self._draw_pipe_vertical(cx, _Y_P201 + 55, _Y_DH - _EQUIP_H//2, "warm")
        
        self._draw_box(cx, _Y_DH, "DH-NET", "District Heating Network", "interactive_DH-NET")
        self._draw_pipe_vertical(cx, _Y_DH + _EQUIP_H//2, _Y_P301 - 24, "cool")
        
        self._draw_pump(cx, _Y_P301, "P-301", "Reinjection Pump", "interactive_P-301")
        self._draw_pipe_vertical(cx, _Y_P301 + 55, _Y_RW - _EQUIP_H//2, "cool")
        
        self._draw_box(cx, _Y_RW, "RW-01", "Reinjection Well", "interactive_RW-01")

    def _draw_pipe_vertical(self, x: int, y1: int, y2: int, temp: str = "hot"):
        colors = {"hot": CLR_HOT_FLUID, "warm": CLR_WARM_FLUID, "cool": CLR_COOL_FLUID}
        self.canvas.create_rectangle(x - PIPE_WIDTH // 2, y1, x + PIPE_WIDTH // 2, y2, fill=colors.get(temp, CLR_PIPE_BG), outline=BORDER)
        self.canvas.create_line(x, y1, x, y2, fill="", tags=f"pipe_{temp}")

    # ── Dynamic updates from Digital Twin ──────────────────────────────────

    def update_from_twin(self, facility):
        self._facility = facility
        
        def get_color(status: str) -> str:
            if status == "CRITICAL": return CLR_CRITICAL
            if status == "WARNING": return CLR_WARNING
            if status == "MAINTENANCE REQUIRED": return "#ffaa00"
            if status == "NORMAL": return CLR_NORMAL
            return CLR_OFFLINE

        pump_running = False
        
        for eq_id, box in self._equip_boxes.items():
            eq = facility.get_equipment(eq_id)
            if not eq: continue
            
            # Update Outline
            self.canvas.itemconfig(box, outline=get_color(eq.status))
            
            # Update Info Label
            if eq_id in self._labels:
                lbl = self._labels[eq_id]["info"]
                if eq.type == "WELL":
                    t = eq.sensors.get("Temperature", 0)
                    p = eq.sensors.get("Pressure", 0)
                    self.canvas.itemconfig(lbl, text=f"{t:.1f} °C | {p:.1f} bar")
                elif eq.type == "PUMP":
                    f = eq.sensors.get("Flow Rate", 0)
                    c = eq.motor_current
                    self.canvas.itemconfig(lbl, text=f"{f:.1f} m3/h | {c:.1f} A")
                    if f > 10: pump_running = True
                elif eq.type == "SEPARATOR":
                    p = eq.sensors.get("Pressure", 0)
                    self.canvas.itemconfig(lbl, text=f"Pres: {p:.1f} bar")
                elif eq.type == "HX":
                    eff = eq.sensors.get("Efficiency", 0)
                    self.canvas.itemconfig(lbl, text=f"Efficiency: {eff:.1f} %")
                elif eq.type == "NETWORK":
                    dt = eq.sensors.get("Delta T", 0)
                    self.canvas.itemconfig(lbl, text=f"Delta T: {dt:.1f} K")

        # Store pump_running for the animation loop
        self._pump_running = pump_running

    def _animate_tick(self):
        if self._pump_running:
            self._flow_offset = (self._flow_offset + 2) % 20
            self.canvas.delete("chevron")
            for temp_type in ("hot", "warm", "cool"):
                lines = self.canvas.find_withtag(f"pipe_{temp_type}")
                for line in lines:
                    coords = self.canvas.coords(line)
                    if not coords: continue
                    x, y1, _, y2 = coords
                    for y in range(int(y1) + self._flow_offset, int(y2) - 4, 20):
                        self.canvas.create_line(x - 4, y, x, y + 6, x + 4, y, fill=BORDER_LIGHT, width=2, tags="chevron")
            
            # Animate pump rotors
            self._pump_angle = (self._pump_angle + 10) % 360
            rad = math.radians(self._pump_angle)
            rad2 = math.radians(self._pump_angle + 90)
            
            cx = self._width // 2
            rl = 14 # rotor length
            for pid, (l1, l2) in self._pump_rotors.items():
                if pid == "P-101": cy = _Y_P101
                elif pid == "P-201": cy = _Y_P201
                elif pid == "P-301": cy = _Y_P301
                else: continue
                
                self.canvas.coords(l1, cx - rl*math.cos(rad), cy - rl*math.sin(rad), cx + rl*math.cos(rad), cy + rl*math.sin(rad))
                self.canvas.coords(l2, cx - rl*math.cos(rad2), cy - rl*math.sin(rad2), cx + rl*math.cos(rad2), cy + rl*math.sin(rad2))
                
        self.canvas.after(33, self._animate_tick) # ~30 fps is good enough and lighter on CPU
