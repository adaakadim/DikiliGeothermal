"""
gui/interactive.py
==================
Interactive elements for the Digital Twin SCADA interface.

Provides:
- HoverTooltip: Spawns a floating tooltip box near the cursor on mouse hover.
- EquipmentDetailPopup: A non-blocking popup window showing detailed, live-updating
  parameters for a specific equipment.
"""

import tkinter as tk
import tkinter.ttk as ttk
from typing import Callable, Any

from gui.theme import (
    BG_SECONDARY, BG_HEADER, BORDER, BORDER_LIGHT,
    TEXT_PRIMARY, TEXT_SECONDARY, TEXT_MUTED,
    CLR_NORMAL, CLR_WARNING, CLR_CRITICAL, CLR_OFFLINE,
    FONT_LABEL_SM, FONT_MONO_SM, status_color
)

# ═════════════════════════════════════════════════════════════════════════════
#  HOVER TOOLTIP
# ═════════════════════════════════════════════════════════════════════════════

class HoverTooltip:
    """
    Creates a hover tooltip for a tkinter widget or canvas item.
    """
    def __init__(self, canvas: tk.Canvas, tag_or_id: str | int, text_func: Callable[[], str]):
        """
        canvas: The canvas containing the item.
        tag_or_id: The canvas tag or item ID to bind to.
        text_func: A function that returns the current text to display.
        """
        self.canvas = canvas
        self.tag_or_id = tag_or_id
        self.text_func = text_func
        self.tw = None
        
        self.canvas.tag_bind(self.tag_or_id, "<Enter>", self._enter)
        self.canvas.tag_bind(self.tag_or_id, "<Leave>", self._leave)
        self.canvas.tag_bind(self.tag_or_id, "<Motion>", self._motion)

    def _enter(self, event=None):
        self._schedule_id = self.canvas.after(300, self._show_tooltip, event)

    def _leave(self, event=None):
        if hasattr(self, '_schedule_id'):
            self.canvas.after_cancel(self._schedule_id)
        self._hide_tooltip()

    def _motion(self, event):
        # Update tooltip position if it's visible
        if self.tw:
            x, y = self.canvas.winfo_pointerxy()
            self.tw.wm_geometry(f"+{x + 15}+{y + 10}")

    def _show_tooltip(self, event):
        if self.tw:
            return
            
        x, y = self.canvas.winfo_pointerxy()
        text = self.text_func()
        if not text:
            return

        self.tw = tk.Toplevel(self.canvas)
        self.tw.wm_overrideredirect(True)
        self.tw.wm_geometry(f"+{x + 15}+{y + 10}")
        # Keep tooltip on top
        self.tw.attributes("-topmost", True)

        frame = tk.Frame(self.tw, bg=BG_HEADER, highlightbackground=BORDER_LIGHT, highlightthickness=1)
        frame.pack(ipadx=4, ipady=4)

        label = tk.Label(
            frame, text=text, justify="left",
            bg=BG_HEADER, fg=TEXT_PRIMARY, font=FONT_MONO_SM,
        )
        label.pack()

    def _hide_tooltip(self):
        if self.tw:
            self.tw.destroy()
            self.tw = None


# ═════════════════════════════════════════════════════════════════════════════
#  EQUIPMENT DETAIL POPUP
# ═════════════════════════════════════════════════════════════════════════════

class EquipmentDetailPopup(tk.Toplevel):
    """
    A persistent, non-blocking floating window displaying detailed live stats
    for a single piece of equipment.
    """
    
    # Store instances globally to prevent multiple popups for the same equipment
    _instances: dict[str, 'EquipmentDetailPopup'] = {}

    @classmethod
    def get_or_create(cls, parent: tk.Widget, equip_id: str, equip_type: str) -> 'EquipmentDetailPopup':
        if equip_id in cls._instances:
            inst = cls._instances[equip_id]
            inst.lift()
            return inst
        
        inst = cls(parent, equip_id, equip_type)
        cls._instances[equip_id] = inst
        return inst

    def __init__(self, parent: tk.Widget, equip_id: str, equip_type: str):
        super().__init__(parent)
        self.equip_id = equip_id
        self.equip_type = equip_type
        
        self.title(f"Equipment Details: {equip_id}")
        self.configure(bg=BG_SECONDARY)
        self.resizable(False, False)
        
        # Bring to front but don't block
        self.attributes("-topmost", True)
        self.protocol("WM_DELETE_WINDOW", self._on_close)
        
        # Variables dict to hold the tk.StringVar for each field
        self._vars: dict[str, tk.StringVar] = {}
        
        self._build_ui()
        
    def _on_close(self):
        if self.equip_id in EquipmentDetailPopup._instances:
            del EquipmentDetailPopup._instances[self.equip_id]
        self.destroy()

    def _build_ui(self):
        # Header
        hdr = tk.Frame(self, bg=BG_HEADER)
        hdr.pack(fill="x")
        tk.Label(
            hdr, text=f" {self.equip_type.upper()}",
            bg=BG_HEADER, fg=TEXT_SECONDARY, font=FONT_LABEL_SM, anchor="w"
        ).pack(side="top", fill="x", padx=4, pady=(4, 0))
        tk.Label(
            hdr, text=f" {self.equip_id}",
            bg=BG_HEADER, fg=TEXT_PRIMARY, font=("Segoe UI", 16, "bold"), anchor="w"
        ).pack(side="top", fill="x", padx=4, pady=(0, 4))
        
        self.notebook = ttk.Notebook(self)
        self.notebook.pack(fill="both", expand=True, padx=4, pady=4)
        
        # Tabs
        self.tab_live = tk.Frame(self.notebook, bg=BG_SECONDARY, padx=10, pady=10)
        self.tab_ai = tk.Frame(self.notebook, bg=BG_SECONDARY, padx=10, pady=10)
        
        self.notebook.add(self.tab_live, text="Live Data")
        self.notebook.add(self.tab_ai, text="AI Insights")

    def update_from_twin(self, eq):
        """
        Updates the key-value grid directly from a Digital Twin Equipment object.
        """
        # --- Live Data Tab ---
        live_data = {
            "Status": eq.status,
            "Health Score": f"{eq.health_score:.1f} %"
        }
        if eq.operating_hours > 0: live_data["Operating Hours"] = f"{eq.operating_hours:.0f} h"
        if eq.motor_current > 0: live_data["Motor Current"] = f"{eq.motor_current:.1f} A"
        if eq.power_consumption > 0: live_data["Power Load"] = f"{eq.power_consumption:.1f} kW"
            
        for k, v in eq.sensors.items():
            if k in ["Operating Hours", "Motor Current (A)", "Power (kW)"]: continue
            if isinstance(v, float):
                live_data[k] = f"{v:.2f}"
            else:
                live_data[k] = str(v)
                
        self._render_dict_to_frame(live_data, self.tab_live)
        
        # --- AI Insights Tab ---
        ai_data = {}
        if eq.failure_risk > 0:
            ai_data["Failure Risk"] = f"{eq.failure_risk:.1f} %"
            ai_data["AI Confidence"] = f"{eq.ai_confidence:.1f} %"
            ai_data["AI Advice"] = eq.ai_recommendation
            if eq.explanation_text:
                ai_data["AI Explanation"] = eq.explanation_text
        else:
            ai_data["AI Insight"] = "No predictive models active for this component."
            
        self._render_dict_to_frame(ai_data, self.tab_ai)

    def _render_dict_to_frame(self, data_dict, frame):
        for i, (key, val) in enumerate(data_dict.items()):
            var_key = f"{id(frame)}_{key}"
            if var_key not in self._vars:
                self._vars[var_key] = tk.StringVar(value=str(val))
                lbl_key = tk.Label(frame, text=key, bg=BG_SECONDARY, fg=TEXT_SECONDARY, font=FONT_LABEL_SM, anchor="w", wraplength=150)
                lbl_key.grid(row=i, column=0, sticky="w", padx=(0, 15), pady=2)
                
                lbl_val = tk.Label(frame, textvariable=self._vars[var_key], bg=BG_SECONDARY, fg=TEXT_PRIMARY, font=FONT_MONO_SM, anchor="w", wraplength=250, justify="left")
                lbl_val.grid(row=i, column=1, sticky="w", pady=2)
                
                if "status" in key.lower() or "health" in key.lower() or "risk" in key.lower():
                    self._update_color(lbl_val, str(val))
                    lbl_val._is_status = True
                else:
                    lbl_val._is_status = False
            else:
                self._vars[var_key].set(str(val))
                
        for child in frame.winfo_children():
            if isinstance(child, tk.Label) and getattr(child, '_is_status', False):
                self._update_color(child, child.cget("text"))

    def _update_color(self, label: tk.Label, text: str):
        text_upper = text.upper()
        if "CRIT" in text_upper or "FAULT" in text_upper or "CLOSED" in text_upper:
            label.config(fg=CLR_CRITICAL)
        elif "WARN" in text_upper or "THROTTLE" in text_upper:
            label.config(fg=CLR_WARNING)
        elif "OFF" in text_upper:
            label.config(fg=CLR_OFFLINE)
        else:
            label.config(fg=CLR_NORMAL)
