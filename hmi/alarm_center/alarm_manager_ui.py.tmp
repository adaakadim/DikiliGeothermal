"""
hmi/alarm_center/alarm_manager_ui.py
====================================
Professional Industrial Alarm Center.
"""

import tkinter as tk
import tkinter.ttk as ttk
from gui.theme import BG_PRIMARY, BG_SECONDARY, BG_HEADER, BORDER, TEXT_PRIMARY, TEXT_SECONDARY, CLR_CRITICAL, CLR_WARNING, CLR_NORMAL, FONT_SUBTITLE, FONT_MONO_SM

class AlarmCenterPanel(tk.Frame):
    def __init__(self, parent: tk.Widget, alarm_manager, **kwargs):
        super().__init__(parent, bg=BG_PRIMARY, **kwargs)
        self._alarm_manager = alarm_manager
        
        lbl = tk.Label(self, text="ALARM CENTER", bg=BG_PRIMARY, fg=TEXT_SECONDARY, font=FONT_SUBTITLE)
        lbl.pack(pady=10, anchor="w", padx=20)
        
        # Action bar
        actions = tk.Frame(self, bg=BG_PRIMARY)
        actions.pack(fill="x", padx=20, pady=(0, 10))
        
        tk.Button(actions, text="Acknowledge Selected", bg="#374151", fg=TEXT_PRIMARY, relief="flat", command=self._ack_selected).pack(side="left", padx=(0, 10))
        tk.Button(actions, text="Acknowledge All", bg="#374151", fg=TEXT_PRIMARY, relief="flat", command=self._ack_all).pack(side="left")
        
        # Treeview
        columns = ("Timestamp", "ID", "Tag", "Description", "Priority", "Status")
        self.tree = ttk.Treeview(self, columns=columns, show="headings", style="Alarm.Treeview", height=20)
        
        for col in columns:
            self.tree.heading(col, text=col)
            self.tree.column(col, width=150 if col != "Description" else 400)
            
        self.tree.pack(fill="both", expand=True, padx=20, pady=(0, 20))
        
        # Style definition (should ideally be in theme.py but safe here)
        style = ttk.Style()
        style.configure("Alarm.Treeview", background=BG_SECONDARY, foreground=TEXT_PRIMARY, fieldbackground=BG_SECONDARY, rowheight=30)
        style.map("Alarm.Treeview", background=[("selected", BG_HEADER)])
        
    def _ack_selected(self):
        for item in self.tree.selection():
            alarm_id = self.tree.item(item, "values")[1]
            if alarm_id in self._alarm_manager.active_alarms:
                self._alarm_manager.acknowledge_alarm(alarm_id)
                
    def _ack_all(self):
        for aid in list(self._alarm_manager.active_alarms.keys()):
            self._alarm_manager.acknowledge_alarm(aid)

    def update_alarms(self):
        # Clear tree
        for item in self.tree.get_children():
            self.tree.delete(item)
            
        # Repopulate
        for alarm in self._alarm_manager.active_alarms:
            self.tree.insert("", "end", values=(
                alarm.timestamp, alarm.alarm_id, alarm.tag_id, alarm.description, alarm.priority.name, "ACTIVE" if not alarm.acknowledged else "ACKNOWLEDGED"
            ), tags=(alarm.priority.name,))
            
        self.tree.tag_configure("CRITICAL", background="#450a0a", foreground="#f87171")
        self.tree.tag_configure("HIGH", background="#451a03", foreground="#fb923c")
