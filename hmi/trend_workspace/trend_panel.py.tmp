"""
hmi/trend_workspace/trend_panel.py
==================================
Professional Trend Workspace wrapper.
"""

import tkinter as tk
from gui.theme import BG_PRIMARY, TEXT_SECONDARY, FONT_SUBTITLE
from gui.trend_charts import TrendChartPanel

class TrendWorkspace(tk.Frame):
    def __init__(self, parent: tk.Widget, well_ids: list, **kwargs):
        super().__init__(parent, bg=BG_PRIMARY, **kwargs)
        
        lbl = tk.Label(self, text="TREND WORKSPACE", bg=BG_PRIMARY, fg=TEXT_SECONDARY, font=FONT_SUBTITLE)
        lbl.pack(pady=10, anchor="w", padx=20)
        
        self.charts = TrendChartPanel(self, well_ids=well_ids)
        self.charts.pack(fill="both", expand=True, padx=20, pady=(0, 20))
        
    def update_data(self, readings, reports, ai_result):
        self.charts.update_data(readings, reports, ai_result)
