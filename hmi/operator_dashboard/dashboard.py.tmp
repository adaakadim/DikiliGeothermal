"""
hmi/operator_dashboard/dashboard.py
===================================
High-level Operator Dashboard showing plant status and critical KPIs.
"""

import tkinter as tk
from gui.theme import BG_PRIMARY, BG_SECONDARY, BG_HEADER, BORDER, TEXT_PRIMARY, TEXT_SECONDARY, TEXT_MUTED, FONT_SUBTITLE, FONT_TITLE, FONT_LABEL_SM, CLR_NORMAL, CLR_WARNING, CLR_CRITICAL

class OperatorDashboard(tk.Frame):
    def __init__(self, parent: tk.Widget, **kwargs):
        super().__init__(parent, bg=BG_PRIMARY, **kwargs)
        
        lbl = tk.Label(self, text="OPERATOR DASHBOARD", bg=BG_PRIMARY, fg=TEXT_SECONDARY, font=FONT_TITLE)
        lbl.pack(pady=10, anchor="w", padx=20)
        
        # Grid container
        self.grid_frame = tk.Frame(self, bg=BG_PRIMARY)
        self.grid_frame.pack(fill="both", expand=True, padx=20, pady=10)
        
        for i in range(2):
            self.grid_frame.columnconfigure(i, weight=1)
            self.grid_frame.rowconfigure(i, weight=1)
            
        self.tiles = {}
        
        self._build_tile("status", 0, 0, "Plant Status", "---", CLR_NORMAL)
        self._build_tile("health", 0, 1, "Overall Plant Health", "---", CLR_NORMAL)
        self._build_tile("risk_eq", 1, 0, "Highest Risk Equipment", "None", TEXT_PRIMARY)
        self._build_tile("alarm", 1, 1, "Most Critical Alarm", "None", TEXT_PRIMARY)
        self._build_tile("power", 2, 0, "Thermal Power", "--- MW", TEXT_PRIMARY)
        self._build_tile("energy", 2, 1, "Energy Production", "--- MWh", TEXT_PRIMARY)
        
    def _build_tile(self, key, row, col, title, default_val, color):
        f = tk.Frame(self.grid_frame, bg=BG_SECONDARY, highlightbackground=BORDER, highlightthickness=1)
        f.grid(row=row, column=col, sticky="nsew", padx=10, pady=10)
        
        tk.Label(f, text=title.upper(), bg=BG_SECONDARY, fg=TEXT_SECONDARY, font=FONT_SUBTITLE).pack(pady=(20, 10))
        val_lbl = tk.Label(f, text=default_val, bg=BG_SECONDARY, fg=color, font=("Segoe UI", 36, "bold"))
        val_lbl.pack(expand=True)
        
        self.tiles[key] = val_lbl

    def update_dashboard(self, status, health, highest_risk_eq, critical_alarm, power, energy):
        self.tiles["status"].config(text=status, fg=CLR_CRITICAL if status == "CRITICAL" else (CLR_WARNING if status == "WARNING" else CLR_NORMAL))
        self.tiles["health"].config(text=f"{health:.1f}%", fg=CLR_CRITICAL if health < 60 else (CLR_WARNING if health < 80 else CLR_NORMAL))
        self.tiles["risk_eq"].config(text=highest_risk_eq)
        self.tiles["alarm"].config(text=critical_alarm)
        self.tiles["power"].config(text=f"{power:.2f} MW")
        self.tiles["energy"].config(text=f"{energy:.1f} MWh")
