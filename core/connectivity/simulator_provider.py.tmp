"""
core/connectivity/simulator_provider.py
=======================================
Implements IDataProvider using the existing digital twin simulation.
"""

from typing import List, Any
import logging
from .provider import IDataProvider
from simulation.sensors import SensorReading, create_well_array

logger = logging.getLogger(__name__)

class SimulatorDataProvider(IDataProvider):
    """
    Data provider that wraps the internal Geothermal Simulation logic.
    """

    def __init__(self):
        self._connected = False
        self._wells = []
        # Pump speeds can be controlled via write_tag
        self._pump_speeds = {}

    def connect(self) -> bool:
        """Initialize the simulator."""
        try:
            self._wells = create_well_array()
            for w in self._wells:
                self._pump_speeds[w.well_id] = 1450.0  # Default RPM
            self._connected = True
            logger.info("SimulatorDataProvider connected successfully.")
            return True
        except Exception as e:
            logger.error(f"Failed to connect SimulatorDataProvider: {e}")
            self._connected = False
            return False

    def disconnect(self) -> None:
        """Stop the simulator."""
        self._connected = False
        self._wells = []
        logger.info("SimulatorDataProvider disconnected.")

    def is_connected(self) -> bool:
        return self._connected

    def read_all(self) -> List[SensorReading]:
        """Read latest simulated sensor values."""
        if not self._connected:
            return []
        
        readings = []
        for w in self._wells:
            # The simulator has internal state. We just call read()
            # but we can also inject the current pump speed if needed.
            # Currently simulation/sensors.py generate_sensor_readings expects pump_speed_rpm
            # However, create_well_array returns GeothermalWellSensor instances which have a .read() method
            # Wait, let's check simulation.sensors.py to ensure we use it correctly!
            r = w.read()
            readings.append(r)
        
        return readings

    def write_tag(self, tag_id: str, value: Any) -> bool:
        """
        Simulate writing a value (e.g. pump speed).
        tag_id could be formatted like 'P-101.Speed'
        """
        if tag_id.endswith(".Speed"):
            well_id = tag_id.split(".")[0].replace("P", "W") # Simplified mapping
            if well_id in self._pump_speeds:
                self._pump_speeds[well_id] = float(value)
                logger.info(f"SimulatorDataProvider: Set {tag_id} to {value}")
                return True
        return False
