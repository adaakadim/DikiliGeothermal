"""
simulation/plant_simulator.py
Physics-based geothermal district heating plant simulator.
Provides realistic, time-varying sensor readings with noise and transients.
"""

import math
import random
import time
import logging
from typing import Dict

from scada.config import SystemConfig
from scada.tag_database import TagDatabase, TagQuality

logger = logging.getLogger(__name__)

# Pump status labels
PUMP_STATES = ["RUNNING", "STOPPED", "FAULT", "STARTING"]


class PlantSimulator:
    """
    Simulates the Dikili Geothermal plant process:
      - Three geothermal production wells
      - Plate heat exchanger
      - District heating distribution network (4 zones)

    Process model: simplified thermal-hydraulic balance updated every tick.
    """

    def __init__(self, config: SystemConfig, db: TagDatabase):
        self.config = config
        self.db = db
        self._t0 = time.time()

        # Internal state (slow-moving "truth" values)
        self._well_state: Dict[str, dict] = {}
        self._load_factor = 0.75        # 0..1, simulates demand fluctuation
        self._ambient_temp = 12.0       # °C ambient for heat loss calc

    def initialise(self):
        for well in self.config.wells:
            self._well_state[well.well_id] = {
                "temp":   well.reservoir_temp_c * 0.95,
                "pres":   well.nominal_pressure_bar,
                "flow":   well.max_flow_m3h * 0.70,
                "pump_sp":70.0,
                "pump_st":"RUNNING",
            }
        logger.info("Plant simulator initialised with %d wells.", len(self._well_state))

    def step(self):
        """Advance simulation by one scan cycle and write tags."""
        elapsed = time.time() - self._t0

        # Slowly vary load factor (simulates daily demand cycle)
        self._load_factor = 0.55 + 0.35 * abs(math.sin(elapsed / 900.0))

        # Update each well
        total_flow = 0.0
        weighted_temp = 0.0

        for well in self.config.wells:
            wid = well.well_id
            ws  = self._well_state[wid]

            # Gradual drift + Gaussian noise
            ws["temp"]  = self._drift(ws["temp"],  well.reservoir_temp_c * 0.95, 0.05, 0.3)
            ws["pres"]  = self._drift(ws["pres"],  well.nominal_pressure_bar,    0.02, 0.08)
            ws["flow"]  = self._drift(ws["flow"],  well.max_flow_m3h * self._load_factor, 0.1, 2.0)
            ws["pump_sp"]= round(self._load_factor * 85.0, 1)

            # Occasional simulated fault (1% per step)
            if random.random() < 0.01:
                ws["pump_st"] = random.choice(["STARTING", "FAULT"])
                logger.debug("Simulated transient on %s: %s", wid, ws["pump_st"])
            else:
                ws["pump_st"] = "RUNNING"

            # Write to tag DB
            self.db.write(f"{wid}.TEMP",    round(ws["temp"], 2))
            self.db.write(f"{wid}.PRES",    round(ws["pres"], 2))
            self.db.write(f"{wid}.FLOW",    round(max(ws["flow"], 0.0), 1))
            self.db.write(f"{wid}.PUMP_ST", ws["pump_st"])
            self.db.write(f"{wid}.PUMP_SP", ws["pump_sp"])

            total_flow     += ws["flow"]
            weighted_temp  += ws["temp"] * ws["flow"]

        # ── Heat Exchanger ─────────────────────────────────────────────────────
        if total_flow > 0:
            avg_geo_temp = weighted_temp / total_flow
        else:
            avg_geo_temp = self.config.min_wellhead_temp_c

        hx_eff = self.config.hx_efficiency
        sec_supply = avg_geo_temp * hx_eff + self._noise(0.3)
        sec_supply = round(min(sec_supply, self.config.target_supply_temp_c + 10), 2)

        # Return temperature based on demand & ΔT
        delta_t_design = self.config.target_supply_temp_c - self.config.target_return_temp_c
        sec_return = sec_supply - delta_t_design * self._load_factor + self._noise(0.4)

        self.db.write("HX.SUPPLY_TEMP",  round(avg_geo_temp + self._noise(0.2), 2))
        self.db.write("HX.RETURN_TEMP",  round(avg_geo_temp - delta_t_design * 0.6, 2))
        self.db.write("HX.SEC_SUPPLY",   sec_supply)
        self.db.write("HX.SEC_RETURN",   round(sec_return, 2))

        # ── District Heating Network ───────────────────────────────────────────
        dh_flow = total_flow * 0.95 + self._noise(1.5)
        dh_pres = 4.5 + self._load_factor * 1.5 + self._noise(0.05)

        self.db.write("DH.TOTAL_FLOW",  round(max(dh_flow, 0.0), 1))
        self.db.write("DH.SUPPLY_PRES", round(dh_pres, 2))
        self.db.write("DH.RETURN_PRES", round(dh_pres - 1.8, 2))

        # Per-zone simulation
        total_zone_flow = max(dh_flow, 1.0)
        for i, zone in enumerate(self.config.zones):
            zid = zone.zone_id
            share = zone.design_load_mw / sum(z.design_load_mw for z in self.config.zones)
            z_flow = total_zone_flow * share + self._noise(0.5)
            z_sup  = sec_supply - i * 1.2 + self._noise(0.2)   # small drop per zone
            z_ret  = z_sup - delta_t_design * 0.8 + self._noise(0.3)
            z_vlv  = round(share * 90.0 * self._load_factor + self._noise(1.0), 1)

            self.db.write(f"{zid}.FLOW",      round(max(z_flow, 0.0), 1))
            self.db.write(f"{zid}.SUPPLY_T",  round(z_sup, 2))
            self.db.write(f"{zid}.RETURN_T",  round(z_ret, 2))
            self.db.write(f"{zid}.VALVE_POS", round(min(max(z_vlv, 0.0), 100.0), 1))

    # ── Helpers ───────────────────────────────────────────────────────────────
    @staticmethod
    def _noise(sigma: float) -> float:
        return random.gauss(0.0, sigma)

    @staticmethod
    def _drift(current: float, target: float, rate: float, noise_sigma: float) -> float:
        """Exponential drift toward target with Gaussian noise."""
        return current + rate * (target - current) + random.gauss(0.0, noise_sigma)
