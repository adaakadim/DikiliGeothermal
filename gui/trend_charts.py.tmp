"""
gui/trend_charts.py
===================
Embedded matplotlib trend charts for the graphical SCADA interface.

Provides a ``TrendChartPanel`` that embeds four rolling time-series plots
(Temperature, Pressure, Flow Rate, Risk Score) inside a tkinter frame
using ``FigureCanvasTkAgg``.

Uses the same dark industrial colour scheme and per-well trace colours
as the standalone matplotlib dashboard.
"""

from __future__ import annotations

import time
from collections import deque

import matplotlib  # type: ignore
matplotlib.use("TkAgg")
import matplotlib.pyplot as plt  # type: ignore
from matplotlib.backends.backend_tkagg import FigureCanvasTkAgg  # type: ignore
from matplotlib.figure import Figure  # type: ignore

import tkinter as tk

from gui.theme import (
    BG_PRIMARY, BG_SECONDARY, BG_HEADER, BORDER, GRID_LINE,
    TEXT_PRIMARY, TEXT_SECONDARY, TEXT_MUTED,
    CLR_NORMAL, CLR_WARNING, CLR_CRITICAL,
    WELL_COLORS,
    FONT_LABEL_SM,
)

# Process thresholds for reference lines
_T_HI = 105.0;  _T_LO = 78.0
_P_LO = 4.5
_Q_LO = 80.0
_RISK_WARN = 40.0;  _RISK_CRIT = 70.0

# Rolling buffer size
_MAX_POINTS = 90  # ~3 minutes at 2-second scans


class TrendChartPanel(tk.Frame):
    """
    Panel embedding four matplotlib subplots that update in-place
    every scan cycle.

    Parameters
    ----------
    parent   : Parent tkinter widget.
    well_ids : List of well identifiers to trace.
    """

    def __init__(
        self,
        parent: tk.Widget,
        well_ids: list[str] | None = None,
        **kwargs,
    ):
        super().__init__(parent, bg=BG_PRIMARY, **kwargs)

        if well_ids is None:
            well_ids = ["GW-01", "GW-02", "GW-03"]
        self._well_ids = well_ids
        self._start_time = time.time()

        # ── Rolling data buffers ───────────────────────────────────────────
        self._times: deque[float] = deque(maxlen=_MAX_POINTS)
        
        # We will track plant-wide metrics using a special 'PLANT' key instead of per-well
        self._data: dict[str, dict[str, deque]] = {
            wid: {
                "temp": deque(maxlen=_MAX_POINTS),
                "pres": deque(maxlen=_MAX_POINTS),
                "flow": deque(maxlen=_MAX_POINTS),
            }
            for wid in well_ids
        }
        self._data["PLANT"] = {
            "risk": deque(maxlen=_MAX_POINTS),
            "health": deque(maxlen=_MAX_POINTS),
            "conf": deque(maxlen=_MAX_POINTS),
        }

        # ── Create matplotlib figure ──────────────────────────────────────
        self._fig = Figure(figsize=(8, 4.5), dpi=85)
        self._fig.patch.set_facecolor(BG_PRIMARY)
        self._fig.subplots_adjust(
            hspace=0.55, wspace=0.35,
            left=0.09, right=0.98,
            top=0.92, bottom=0.08,
        )

        # Create 2x3 subplot grid
        specs = [
            ("temp",   "TEMPERATURE",      "°C",   (70, 112), [(_T_HI, CLR_WARNING), (_T_LO, CLR_WARNING)]),
            ("pres",   "PRESSURE",         "bar",  (2, 13),   [(_P_LO, CLR_WARNING)]),
            ("flow",   "FLOW RATE",        "m³/h", (40, 310), [(_Q_LO, CLR_WARNING)]),
            ("risk",   "AI FAILURE RISK",  "%",    (-2, 102), [(_RISK_WARN, CLR_WARNING), (_RISK_CRIT, CLR_CRITICAL)]),
            ("health", "EQUIPMENT HEALTH", "%",    (-2, 102), [(50.0, CLR_CRITICAL), (80.0, CLR_WARNING)]),
            ("conf",   "AI CONFIDENCE",    "%",    (-2, 102), [(70.0, CLR_WARNING)]),
        ]

        self._axes: dict[str, plt.Axes] = {}
        self._lines: dict[str, dict[str, object]] = {}

        for idx, (key, title, unit, ylim, thresholds) in enumerate(specs):
            ax = self._fig.add_subplot(2, 3, idx + 1)
            ax.set_facecolor(BG_SECONDARY)
            ax.set_ylim(*ylim)
            ax.set_title(title, fontsize=8, fontweight="bold",
                         color=TEXT_PRIMARY, pad=4, loc="left")
            ax.set_ylabel(unit, fontsize=7, color=TEXT_SECONDARY, labelpad=2)
            ax.tick_params(colors=TEXT_MUTED, labelsize=6)

            # Grid
            ax.grid(True, color=GRID_LINE, linestyle="--", linewidth=0.4, alpha=0.6)
            for spine in ax.spines.values():
                spine.set_color(BORDER)

            # Threshold reference lines
            for level, color in thresholds:
                ax.axhline(level, color=color, linewidth=0.7,
                           linestyle="--", alpha=0.5)

            # Create line objects
            self._lines[key] = {}
            if key in ["temp", "pres", "flow"]:
                for wid in well_ids:
                    color = WELL_COLORS.get(wid, "#ffffff")
                    line, = ax.plot([], [], color=color, linewidth=1.5, alpha=0.85, label=wid)
                    self._lines[key][wid] = line
                ax.legend(fontsize=6, loc="upper right", facecolor=BG_HEADER, edgecolor=BORDER, labelcolor=TEXT_SECONDARY, framealpha=0.8)
            else:
                # Plant-wide metrics get a single unified line
                line_color = "#3b82f6" if key == "health" else ("#ef4444" if key == "risk" else "#a855f7")
                line, = ax.plot([], [], color=line_color, linewidth=1.5, alpha=0.9, label="Plant")
                self._lines[key]["PLANT"] = line

            self._axes[key] = ax

        # ── Embed in tkinter ──────────────────────────────────────────────
        self._canvas = FigureCanvasTkAgg(self._fig, master=self)
        self._canvas.get_tk_widget().pack(fill="both", expand=True)

    def update_data(self, readings: list, reports: dict, ai_result: dict = None):
        """
        Push new sensor data into buffers and redraw the charts.

        Args:
            readings: List of SensorReading objects
            reports: Plant status reports dict
            ai_result: Optional dictionary from the AI predictor
        """
        now = time.time() - self._start_time
        self._times.append(now)

        for r in readings:
            wid = r.well_id
            if wid in self._data:
                self._data[wid]["temp"].append(r.temperature_c)
                self._data[wid]["pres"].append(r.pressure_bar)
                self._data[wid]["flow"].append(r.flow_m3h)

        if ai_result:
            self._data["PLANT"]["risk"].append(ai_result.get("Pump Failure Probability (%)", 0.0))
            self._data["PLANT"]["health"].append(ai_result.get("Equipment Health (%)", 100.0))
            self._data["PLANT"]["conf"].append(ai_result.get("Prediction Confidence (%)", 100.0))
        else:
            # If no AI data is available, plot zeros or safe defaults
            self._data["PLANT"]["risk"].append(0.0)
            self._data["PLANT"]["health"].append(100.0)
            self._data["PLANT"]["conf"].append(0.0)

        # Update matplotlib lines
        # Sensor plots
        for metric in ["temp", "pres", "flow"]:
            for wid in self._well_ids:
                line = self._lines[metric][wid]
                line.set_data(self._times, self._data[wid][metric])

        # AI plots
        for metric in ["risk", "health", "conf"]:
            line = self._lines[metric]["PLANT"]
            line.set_data(self._times, self._data["PLANT"][metric])

        # Adjust X-axis to scroll
        if self._times:
            xmin = max(0, self._times[-1] - 60)
            xmax = max(60, self._times[-1])
            for ax in self._axes.values():
                ax.set_xlim(xmin, xmax)

        self._canvas.draw_idle()
